{
  "entities": {
    "Rating": {
      "title": "App Rating & Review",
      "description": "User rating and optional experience review for a Sociorax app",
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "description": "Unique identifier of the application"
        },
        "appName": {
          "type": "string",
          "description": "Name of the application"
        },
        "userId": {
          "type": "string",
          "description": "Anonymous Firebase authentication UID of the reviewer"
        },
        "userName": {
          "type": "string",
          "description": "Display name provided by reviewer"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "review": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional user experience comment up to 500 characters"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when rating was created"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp when rating was last updated"
        },
        "date": {
          "type": "string",
          "description": "Human readable formatted date"
        }
      },
      "required": ["appId", "appName", "userId", "rating", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "apps/{appId}/ratings/{userId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "Stores individual user ratings and reviews per application, keyed by user UID to enforce 1 rating per user"
    }
  }
}
